/* Optional Firefox chrome accents. Enable toolkit.legacyUserProfileCustomizations.stylesheets. */
:root {
  --dc-accent: @@ACCENT@@;
  --dc-accent-bg: @@ACCENT_BG@@;
  --dc-panel: @@PANEL@@;
  --dc-surface: @@SURFACE@@;
  --dc-text: @@TEXT@@;
}
#navigator-toolbox, #TabsToolbar, #nav-bar, #PersonalToolbar { background: var(--dc-panel) !important; color: var(--dc-text) !important; }
.tab-background[selected] { background: linear-gradient(var(--dc-accent-bg), var(--dc-panel)) !important; box-shadow: inset 0 2px var(--dc-accent) !important; }
#urlbar-background, #searchbar { background: var(--dc-surface) !important; border-color: var(--dc-accent-bg) !important; }
#urlbar[focused] > #urlbar-background { border-color: var(--dc-accent) !important; box-shadow: 0 0 0 1px var(--dc-accent-bg) !important; }
